{
  "name": "arduino-claw",
  "version": "1.0.0",
  "description": "Arduino-Claw — AI-powered Arduino IDE Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:all": "electron-builder -mwl --x64"
  },
  "keywords": [
    "arduino",
    "ai",
    "ide",
    "embedded",
    "microcontroller",
    "electron"
  ],
  "author": {
    "name": "Captain Labs",
    "email": "support@arduinoclaw.com"
  },
  "homepage": "https://arduinoclaw.com",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.captainlabs.arduinoclaw",
    "productName": "Arduino Claw",
    "copyright": "Copyright © 2026 Captain Labs",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "modules/**/*",
      "electron/**/*",
      "build-resources/**/*",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/docs/**",
      "!dist/**",
      "!**/*.pem",
      "!setup_vps.sh",
      "!.git/**"
    ],
    "mac": {
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "bin/darwin-arm64",
          "to": "bin"
        },
        {
          "from": "arduino-server",
          "to": "arduino-server",
          "filter": [
            "**/*",
            "!__pycache__/**",
            "!arduino_downloads/**",
            "!arduino_data/packages/esp32/**"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "extraResources": [
        {
          "from": "bin/win32-x64",
          "to": "bin"
        },
        {
          "from": "arduino-server",
          "to": "arduino-server",
          "filter": [
            "**/*",
            "!__pycache__/**",
            "!arduino_downloads/**",
            "!arduino_data/packages/esp32/**",
            "!arduino_data/packages/arduino/**"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arduino Claw",
      "uninstallDisplayName": "Arduino Claw",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico"
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "category": "Development;IDE;",
      "extraResources": [
        {
          "from": "bin/linux-x64",
          "to": "bin"
        },
        {
          "from": "arduino-server",
          "to": "arduino-server",
          "filter": [
            "**/*",
            "!__pycache__/**",
            "!arduino_downloads/**",
            "!arduino_data/packages/esp32/**",
            "!arduino_data/packages/arduino/**"
          ]
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    }
  }
}
